{
  "name": "@dank-inc/banger",
  "version": "0.15.1",
  "author": "Elijah Lucian",
  "description": "Typescript Sound Banger",
  "repository": {
    "type": "git",
    "url": "https://github.com/dank-inc/banger"
  },
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "typescript",
    "webaudio",
    "sound",
    "audio",
    "sfx",
    "bgm",
    "sound player"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "compile": "rm -rf lib && tsc",
    "prepublishOnly": "npm run compile",
    "deploy": "npm run compile && npm publish",
    "test": "vitest run",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
